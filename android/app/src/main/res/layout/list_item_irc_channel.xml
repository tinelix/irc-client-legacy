<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/holo4ux_highlight"
    android:orientation="vertical">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="6dp"
        android:text="#channel"
        android:fontFamily="sans-serif-medium"
        android:textSize="18sp"
        tools:ignore="UnusedAttribute" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="2dp"
        android:text="TextView"
        tools:ignore="UnusedAttribute" />

    <LinearLayout
            android:id="@+id/info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="4dp"
            android:gravity="right|end"
            android:orientation="horizontal"
            tools:ignore="RtlHardcoded">

            <LinearLayout
                android:id="@+id/badges_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <dev.tinelix.holoexperience.library.widget.HoloCompatTextView
                    android:id="@+id/category_badge2"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:background="@drawable/badge_shape_white_mini"
                    android:text="MODE 1"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:textAllCaps="true" />

                <dev.tinelix.holoexperience.library.widget.HoloCompatTextView
                    android:id="@+id/category_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/badge_shape_white_mini"
                    android:text="MODE 2"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:textAllCaps="true" />
            </LinearLayout>

        <TextView
            android:id="@+id/members_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|end"
            android:text="40 members"
            tools:ignore="RtlHardcoded" />

        </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/holo_gray_twilight" />

    </LinearLayout>