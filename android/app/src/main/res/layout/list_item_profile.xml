<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:baselineAligned="false">


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profile_item_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginEnd="8dp"
                android:layout_marginRight="8dp"
                android:singleLine="true"
                android:text="Profile Item"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/state_indicator"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/badge_shape_green"
                android:gravity="center_vertical"
                android:text="@string/online_badge"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <TextView
            android:id="@+id/profile_server_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="16dp"
            android:singleLine="true"
            android:text="Server"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/connect_btn"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@color/title_v11_full_transparent"
            android:src="@drawable/ic_action_send"
            android:visibility="visible"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/menu_btn"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@color/title_v11_full_transparent"
            android:src="@drawable/ic_menu_moreoverflow_normal_holo_dark"
            android:visibility="visible"
            tools:ignore="ContentDescription" />
    </LinearLayout>

</LinearLayout>