<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/pinned_message_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/holo_blue_twilight"
        android:orientation="horizontal"
        android:paddingLeft="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingBottom="6dp"
            android:paddingTop="6dp">

            <dev.tinelix.holoexperience.library.widget.HoloCompatTextView
                android:id="@+id/pinned_message_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pinned_message_title"
                android:textColor="@color/holo_blue_bright"
                android:textStyle="bold"
                app:textAllCaps="true" />

            <TextView
                android:id="@+id/pinned_message_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="Pinned message text"
                android:textColor="?android:attr/textColorPrimary" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            app:srcCompat="@drawable/ic_action_delete" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/channel_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="7dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <TextView
            android:id="@+id/members_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:text="5 members" />

        <TextView
            android:id="@+id/server_lag_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="8dp"
            android:text="400 ms"
            android:textColor="@color/holo_blue_light" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/server_lag_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-7dp"
        android:layout_marginTop="-7dp"
        android:max="100"
        android:progress="80"
        android:visibility="visible" />

</LinearLayout>