<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/holo_blue_twilight"
    android:orientation="vertical"
    android:paddingBottom="6dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="6dp">

    <dev.tinelix.holoexperience.library.widget.HoloCompatTextView
        android:id="@+id/pinned_message_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pinned_message_title"
        android:textColor="@color/holo_blue_bright"
        android:textStyle="bold"
        app:textAllCaps="true" />

    <TextView
        android:id="@+id/pinned_message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Pinned message text"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/pinned_message_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="January 6, 2026"
        android:textSize="12sp" />
</LinearLayout>