<PreferenceScreen xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/profile_main_category">

    </PreferenceCategory>
    <Preference
        android:key="profile_name"
        android:title="@string/profile_name"
        android:persistent="false" />
    <Preference
        android:id="@+id/realname"
        android:key="realname"
        android:title="@string/pref_realname"
        android:persistent="false" />
    <Preference
        android:id="@+id/hostname"
        android:key="hostname"
        android:title="@string/pref_hostname"
        android:persistent="false" />
    <Preference
        android:key="nicknames_management"
        android:title="@string/pref_nicknames"
        android:summary="@string/pref_nicknames_summary"
        android:persistent="false" />
    <PreferenceCategory android:title="@string/pref_server_category">
        <Preference
            android:key="server_address"
            android:title="@string/pref_server_address"
            android:persistent="false" />
        <Preference
            android:key="text_encoding"
            android:title="@string/pref_text_encoding"
            android:persistent="false" />
        <CheckBoxPreference
            android:key="tls_only"
            android:title="@string/pref_only_ssl_title"
            android:summary="@string/pref_only_ssl_summary"
            android:persistent="false" />
        <!--<CheckBoxPreference
            android:key="hide_ip"
            android:persistent="false"
            android:summary="@string/pref_hide_ip_summary"
            android:title="@string/pref_hide_ip_title" />!-->
        <Preference
            android:key="ping_interval"
            android:title="@string/pref_ping_interval"
            android:persistent="false" />
    </PreferenceCategory>
    <!--<PreferenceCategory android:title="@string/authorization_category">
        <Preference
            android:defaultValue="true"
            android:enabled="false"
            android:key="auth_method"
            android:persistent="false"
            android:title="@string/pref_login_method" />
        <Preference
            android:enabled="false"
            android:key="password"
            android:title="@string/pref_password"
            android:persistent="false" />
    </PreferenceCategory>!-->
    <Preference
        android:key="quit_message"
        android:singleLine="true"
        android:title="@string/pref_quit_message"
        android:persistent="false" />
</PreferenceScreen>